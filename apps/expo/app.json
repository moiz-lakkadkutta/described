{
  "expo": {
    "name": "Described",
    "slug": "described",
    "scheme": "described",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "dev.moizp.described",
      "permissions": [
        "com.amazon.permission.media.session.voicecommandcontrol"
      ],
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LEANBACK_LAUNCHER",
            "LAUNCHER"
          ]
        }
      ]
    },
    "plugins": [
      "./plugins/withKeyEvent",
      "./plugins/withLocalApi",
      "./plugins/withFireTvVoice",
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "newArchEnabled": false
  }
}
