PORT=4000
AWS_REGION=eu-central-1
BEDROCK_REGION=us-east-1
# Bucket names carry an account-id suffix (described-media-dev-<account>); copy all four from infra/cdk-outputs.json after deploy.
S3_BUCKET_MEDIA=described-media-dev
S3_BUCKET_NOVA_INGEST=described-nova-ingest-dev
CLOUDFRONT_DOMAIN=
CLOUDFRONT_DISTRIBUTION_ID=
NOVA_PRO_MODEL_ID=amazon.nova-pro-v1:0
NOVA_LITE_MODEL_ID=amazon.nova-lite-v1:0
DESCRIBE_MODEL_ID=qwen.qwen3-vl-235b-a22b
# Shots described at once (Converse calls in flight); re-runs read work/{slug}/cache/describe and make no call for unchanged shots.
DESCRIBE_CONCURRENCY=4
POLLY_VOICE_DE=Vicki
POLLY_VOICE_EN=Joanna
